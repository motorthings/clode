# API Keys and Secrets
*.key
*.secret
*_key.txt
*_secret.txt

# Machine-specific configs
.machine-config.json

# Backup files
*.backup
*.bak

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
test_*
scratch/

# ...except tests that are part of a skill. The `test_*` rule above would
# otherwise strip them, and a skill ships with its tests.
!skills/*/tests/
!skills/*/tests/*
